n = int(input("Enter n: "))

if n % 2 == 0:
    print("Magic square is only possible for odd values of n.")
else:
    # Magic constant
    M = n * (n*n + 1) // 2
    print("Magic constant:", M)

    # Initialize magic square with 0
    magic = [[0]*n for _ in range(n)]

    # Starting position
    i = 0
    j = n // 2

    for num in range(1, n*n + 1):
        magic[i][j] = num

        new_i = (i - 1) % n
        new_j = (j + 1) % n

        if magic[new_i][new_j] != 0:
            i = (i + 1) % n
        else:
            i = new_i
            j = new_j

    # Print magic square
    for row in magic:
        for val in row:
            print(f"{val:3}", end=" ")
        print()
